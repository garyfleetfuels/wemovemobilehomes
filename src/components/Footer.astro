---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-950 text-slate-400 text-xs">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand & Strapline -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-500 text-slate-950 font-black text-lg">
            W
          </div>
          <span class="font-bold text-lg text-white">We Move Mobile Homes</span>
        </div>
        <p class="text-slate-300 font-medium mb-3 text-sm">
          Specialist Mobile Home, Static Caravan & Park Home Transport
        </p>
        <p class="text-slate-400 max-w-md leading-relaxed text-xs">
          Specialized abnormal load logistics throughout England, Scotland, Wales, and international destinations. Full turnkey logistics including extendable low loader haulage, Hiab crane placement, pilot escorts, and statutory route clearances.
        </p>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h4 class="font-bold text-slate-200 uppercase tracking-wider text-xs mb-4">Capabilities</h4>
        <ul class="space-y-2.5">
          <li><a href="#services" class="hover:text-amber-400 transition-colors">Static Caravan Transport</a></li>
          <li><a href="#services" class="hover:text-amber-400 transition-colors">Residential Park Homes</a></li>
          <li><a href="#services" class="hover:text-amber-400 transition-colors">Low Loader Haulage</a></li>
          <li><a href="#services" class="hover:text-amber-400 transition-colors">Hiab Crane Hire & Siting</a></li>
          <li><a href="#permits" class="hover:text-amber-400 transition-colors">Abnormal Load Permits & Escorts</a></li>
          <li><a href="#services" class="hover:text-amber-400 transition-colors">International Crossings</a></li>
        </ul>
      </div>

      <!-- Col 3: Compliance & Deployment -->
      <div>
        <h4 class="font-bold text-slate-200 uppercase tracking-wider text-xs mb-4">Standards & Compliance</h4>
        <ul class="space-y-2.5">
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span>Fully Goods-in-Transit Insured</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span>CPCS & ALLMI Crane Operators</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span>ESDAL Highways England Registered</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
            <span>Azure Static Web Apps Ready</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-slate-900 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500">
      <p>&copy; {currentYear} We Move Mobile Homes. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#services" class="hover:text-slate-400 transition-colors">Terms of Haulage</a>
        <a href="#permits" class="hover:text-slate-400 transition-colors">Regulatory Compliance</a>
        <a href="#contact" class="hover:text-slate-400 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
