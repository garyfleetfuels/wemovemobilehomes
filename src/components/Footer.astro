---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-[#070b14] text-slate-400 text-xs">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand & Strapline -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 text-slate-950 font-black text-xl shadow-md shadow-amber-500/20">
            W
          </div>
          <div>
            <span class="font-black text-xl text-white tracking-tight">We Move Mobile Homes</span>
            <span class="block text-[11px] font-bold uppercase tracking-wider text-amber-500">UK & European Heavy Haulage</span>
          </div>
        </div>
        <p class="text-slate-300 font-semibold mb-3 text-sm">
          Specialist Mobile Home, Static Caravan & Park Home Transport
        </p>
        <p class="text-slate-400 max-w-md leading-relaxed text-xs mb-6">
          Specialized abnormal load logistics across England, Scotland, Wales, and mainland Europe. Turnkey operations covering extendable low loader haulage, high-reach Hiab crane siting, emergency failed move rescues, and statutory police escort notifications.
        </p>
        <div class="flex flex-wrap gap-4 text-xs font-bold text-slate-200">
          <a href="tel:+447764341657" class="hover:text-amber-400 transition-colors flex items-center gap-1.5 text-amber-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>07764 341657</span>
          </a>
          <a href="mailto:info@wemovemobilehomes.co.uk" class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>info@wemovemobilehomes.co.uk</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h4 class="font-bold text-slate-200 uppercase tracking-wider text-xs mb-4">Core Capabilities</h4>
        <ul class="space-y-2.5">
          <li><a href="#services" class="hover:text-amber-400 transition-colors">Static Caravan Transport</a></li>
          <li><a href="#services" class="hover:text-amber-400 transition-colors">Twin-Unit Park Homes & Siting</a></li>
          <li><a href="#specialist-fleet" class="hover:text-amber-400 transition-colors">Low Loader Step-Frame Haulage</a></li>
          <li><a href="#services" class="hover:text-amber-400 transition-colors">Hiab Crane Hire & Siting</a></li>
          <li><a href="#permits" class="hover:text-amber-400 transition-colors">Abnormal Load Permits & Escorts</a></li>
          <li><a href="#rescue" class="hover:text-red-400 transition-colors font-semibold">Failed Move Rescue</a></li>
          <li><a href="#services" class="hover:text-amber-400 transition-colors">European Cross-Border Transit</a></li>
        </ul>
      </div>

      <!-- Col 3: Compliance & Deployment -->
      <div>
        <h4 class="font-bold text-slate-200 uppercase tracking-wider text-xs mb-4">Standards & Compliance</h4>
        <ul class="space-y-2.5">
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span>Fully Goods-in-Transit Insured</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span>CPCS & ALLMI Certified Crane Operators</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span>ESDAL Highways England Registered</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span>Chapter 8 High-Visibility Pilot Escorts</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
            <span>Office Hours: Mon–Fri 8am–6pm</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-slate-900 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500">
      <p>&copy; {currentYear} We Move Mobile Homes. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#services" class="hover:text-slate-400 transition-colors">Terms of Haulage</a>
        <a href="#permits" class="hover:text-slate-400 transition-colors">Regulatory Compliance</a>
        <a href="#contact" class="hover:text-slate-400 transition-colors">Contact & Quotes</a>
      </div>
    </div>
  </div>
</footer>
