---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50 text-slate-600 text-xs">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Brand & Contact -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <img
            src="/images/websitelogocolour2.svg"
            alt="We Move Mobile Homes Logo"
            width="140"
            height="44"
            class="h-9 w-auto object-contain"
            loading="lazy"
          />
          <div>
            <span class="font-black text-lg text-slate-900 tracking-tight block">We Move Mobile Homes</span>
            <span class="text-[11px] font-bold uppercase tracking-wider text-red-600">UK Nationwide & European Haulage</span>
          </div>
        </div>
        <p class="text-slate-600 font-medium mb-3 text-sm">
          Specialist Mobile Home, Static Caravan & Abnormal Load Transport
        </p>
        <p class="text-slate-500 max-w-md leading-relaxed text-xs mb-5">
          Dedicated step-frame low loader haulage, Hiab crane lifting, and pitch siting across England, Scotland, Wales, and mainland Europe. 100% legal compliance with police notifications and ESDAL movement orders.
        </p>
        <div class="flex flex-wrap gap-4 text-xs font-bold text-slate-800">
          <a href="tel:+441474444081" class="hover:text-red-600 transition-colors flex items-center gap-1.5 text-red-600 font-extrabold">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Office: 01474 444081</span>
          </a>
          <a href="tel:+447764341657" class="hover:text-red-600 transition-colors flex items-center gap-1.5 text-slate-800">
            <span>Gary: 07764 341657</span>
          </a>
          <a href="mailto:info@wemovemobilehomes.co.uk" class="hover:text-red-600 transition-colors flex items-center gap-1.5 text-slate-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>info@wemovemobilehomes.co.uk</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Fast Navigation -->
      <div>
        <h4 class="font-extrabold text-slate-900 uppercase tracking-wider text-xs mb-3.5">Navigation</h4>
        <ul class="space-y-2 text-slate-600 font-medium">
          <li><a href="#overview" class="hover:text-red-600 transition-colors">Overview</a></li>
          <li><a href="#services" class="hover:text-red-600 transition-colors">Transport Services</a></li>
          <li><a href="#quote" class="hover:text-red-600 transition-colors">Gary Turner's Quote Form</a></li>
          <li><a href="https://wemovemobilehomes.co.uk/services" target="_blank" rel="noopener noreferrer" class="hover:text-red-600 transition-colors">Live Services Page ↗</a></li>
        </ul>
      </div>

      <!-- Col 3: Operating Hours & Standards -->
      <div>
        <h4 class="font-extrabold text-slate-900 uppercase tracking-wider text-xs mb-3.5">Hours & Compliance</h4>
        <ul class="space-y-2 text-slate-600">
          <li class="font-medium">
            <span class="block text-slate-900 font-bold">Office Hours:</span>
            <span>Monday – Friday: 08:00 – 18:00</span>
          </li>
          <li class="flex items-center gap-1.5 pt-1">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
            <span>Fully Goods-in-Transit Insured</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
            <span>ESDAL & Police Movement Orders</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
            <span>Hiab Certified Crane Supervisors</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom copyright -->
    <div class="border-t border-slate-200 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-slate-500 text-[11px]">
      <p>&copy; {currentYear} We Move Mobile Homes UK/EU. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="#overview" class="hover:text-slate-700">Back to Top ↑</a>
      </div>
    </div>
  </div>
</footer>
