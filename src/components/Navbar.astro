---
// Navbar component
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/90 bg-white/95 backdrop-blur-md transition-all shadow-xs">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 sm:py-4 lg:px-8">
    <!-- Brand / Logo -->
    <a href="#overview" class="flex items-center shrink-0 py-1 transition-opacity hover:opacity-95" id="brand-logo-link" aria-label="We Move Mobile Homes - Overview">
      <img 
        src="/images/websitelogocolour2.svg" 
        alt="We Move Mobile Homes Logo" 
        class="h-10 sm:h-12 md:h-14 w-auto object-contain block"
      />
    </a>

    <!-- Desktop Navigation Links: Minimal 3 anchors -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-bold text-slate-900">
      <a href="#overview" class="transition hover:text-red-700">Overview</a>
      <a href="#services" class="transition hover:text-red-700">Services</a>
      <a href="#quote" class="transition hover:text-red-700">Get a Quote</a>
    </nav>

    <!-- Direct Call Button & Quick Contact -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Landline Direct Call -->
      <a
        href="tel:+441474444081"
        id="nav-call-landline"
        class="inline-flex items-center gap-1.5 sm:gap-2 rounded-lg bg-red-600 px-2.5 py-1.5 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-extrabold text-white shadow-xs transition-all hover:bg-red-700 active:scale-95 shrink-0 whitespace-nowrap"
        title="Call our main office line"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span class="hidden sm:inline">Call: 01474 444081</span>
        <span class="sm:hidden font-black">01474 444081</span>
      </a>

      <!-- Gary Turner Direct Mobile (Desktop & Tablet) -->
      <a
        href="tel:+447764341657"
        id="nav-call-mobile"
        class="hidden lg:inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-slate-100 px-3 py-2 text-xs font-bold text-slate-900 transition hover:bg-slate-200 hover:border-slate-400 shrink-0 whitespace-nowrap"
        title="Call Gary Turner directly on mobile"
      >
        <span class="text-slate-700 font-semibold">Gary:</span>
        <span class="font-extrabold text-slate-900">07764 341657</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden inline-flex items-center justify-center rounded-lg p-2 text-slate-900 hover:bg-slate-100 focus:outline-none shrink-0"
        aria-label="Toggle navigation menu"
      >
        <svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-5 space-y-3">
    <div class="flex flex-col space-y-2 text-base font-extrabold text-slate-900">
      <a href="#overview" class="py-2 hover:text-red-700 transition-colors">Overview</a>
      <a href="#services" class="py-2 hover:text-red-700 transition-colors">Services</a>
      <a href="#quote" class="py-2 hover:text-red-700 transition-colors">Get a Quote</a>
    </div>
    <div class="pt-3 border-t border-slate-200 flex flex-col gap-2">
      <a
        href="tel:+441474444081"
        class="flex items-center justify-center gap-2 rounded-lg bg-red-600 py-2.5 text-sm font-extrabold text-white shadow-xs"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call Office: 01474 444081</span>
      </a>
      <a
        href="tel:+447764341657"
        class="flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-slate-100 py-2 text-sm font-bold text-slate-900"
      >
        <span>Call Gary Directly: 07764 341657</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (menuBtn && menu) {
    menuBtn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    // Close menu when clicking any anchor link
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }
</script>
