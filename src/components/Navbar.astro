---
---

<!-- Emergency Dispatch Banner -->
<aside aria-label="Dispatch status" class="bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 border-b border-amber-500/20 text-xs py-1.5 px-4 text-slate-300">
  <div class="mx-auto flex max-w-7xl items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="font-medium text-slate-200">Dispatch Office:</span>
      <span class="text-slate-400 hidden sm:inline">Mon–Fri 8am–6pm • 24/7 Failed Move Rescue Hotline</span>
    </div>
    <div class="flex items-center gap-4 text-xs">
      <a href="mailto:info@wemovemobilehomes.co.uk" class="text-slate-300 hover:text-amber-400 transition-colors hidden md:inline-flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
        </svg>
        <span>info@wemovemobilehomes.co.uk</span>
      </a>
      <a href="tel:+447764341657" class="text-amber-400 hover:text-amber-300 font-bold inline-flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-red-500" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
        </svg>
        <span>07764 341657</span>
      </a>
    </div>
  </div>
</aside>

<header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-[#0b1120]/90 backdrop-blur-md transition-all">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand / Logo -->
    <a href="/" class="group flex items-center gap-3 transition-transform duration-200 hover:scale-[1.01]" id="brand-logo-link">
      <div class="relative flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 via-amber-600 to-amber-700 shadow-lg shadow-amber-500/20 text-slate-950 font-black">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 stroke-[2.4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" />
          <path d="M15 18H9" />
          <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14v10Z" />
          <circle cx="17" cy="18" r="2" />
          <circle cx="7" cy="18" r="2" />
        </svg>
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5">
          <span class="font-black text-lg sm:text-xl tracking-tight text-white group-hover:text-amber-400 transition-colors">
            We Move Mobile Homes
          </span>
          <span class="rounded bg-amber-500/10 px-1.5 py-0.5 text-[9px] font-black uppercase text-amber-400 border border-amber-500/30 hidden lg:inline">
            UK & EU
          </span>
        </div>
        <span class="text-[11px] font-semibold uppercase tracking-wider text-amber-400/90">
          Specialist Heavy & Abnormal Haulage
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-7 text-sm font-semibold text-slate-200">
      <a href="#services" class="transition hover:text-amber-400">Services</a>
      <a href="#specialist-fleet" class="transition hover:text-amber-400">Specialist Fleet</a>
      <a href="#permits" class="transition hover:text-amber-400">Permits & Escorts</a>
      <a href="#rescue" class="transition hover:text-amber-400 flex items-center gap-1.5 text-amber-300">
        <span class="h-1.5 w-1.5 rounded-full bg-red-500 animate-ping"></span>
        <span>Failed Move Rescue</span>
      </a>
      <a href="#contact" class="transition hover:text-amber-400">Quote Calculator</a>
    </nav>

    <!-- Quick Action / CTA -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Click to Call Button -->
      <a
        href="tel:+447764341657"
        id="nav-call-btn"
        class="inline-flex items-center gap-2 rounded-lg border border-red-600/40 bg-red-600/10 px-3 py-2 sm:px-3.5 sm:py-2 text-xs sm:text-sm font-bold text-red-300 transition-all hover:bg-red-600 hover:text-white hover:border-red-600 shadow-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span class="hidden sm:inline">Call Dispatch:</span>
        <span>07764 341657</span>
      </a>

      <!-- Instant Quote Button -->
      <a
        href="#contact"
        id="nav-quote-btn"
        class="inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-3.5 py-2 text-xs sm:text-sm font-bold text-slate-950 shadow-md shadow-amber-500/20 transition-all hover:bg-amber-400 hover:shadow-lg active:scale-95"
      >
        <span>Get Quote</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
