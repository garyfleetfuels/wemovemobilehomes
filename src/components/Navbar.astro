---
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-md transition-all">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand / Logo -->
    <a href="/" class="group flex items-center gap-3 transition-transform duration-200 hover:scale-[1.01]" id="brand-logo-link">
      <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 shadow-md shadow-amber-500/20 text-slate-950">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" />
          <path d="M15 18H9" />
          <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14v10Z" />
          <circle cx="17" cy="18" r="2" />
          <circle cx="7" cy="18" r="2" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-lg sm:text-xl tracking-tight text-white group-hover:text-amber-400 transition-colors">
          We Move Mobile Homes
        </span>
        <span class="text-[11px] font-medium uppercase tracking-wider text-amber-500">
          Heavy & Abnormal Logistics
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
      <a href="#services" class="transition hover:text-amber-400">Services</a>
      <a href="#specialist-fleet" class="transition hover:text-amber-400">Specialist Fleet</a>
      <a href="#permits" class="transition hover:text-amber-400">Permits & Escorts</a>
      <a href="#coverage" class="transition hover:text-amber-400">UK & International</a>
    </nav>

    <!-- Quick Action / CTA -->
    <div class="flex items-center gap-3">
      <a
        href="#contact"
        id="nav-quote-btn"
        class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2.5 text-xs sm:text-sm font-semibold text-slate-950 shadow-md shadow-amber-500/15 transition-all hover:bg-amber-400 hover:shadow-lg hover:shadow-amber-500/25 active:scale-95"
      >
        <span>Request a Quote</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
