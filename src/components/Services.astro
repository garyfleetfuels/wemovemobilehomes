---
const services = [
  {
    id: 'mobile-homes',
    title: 'Moving Mobile Homes & Caravans',
    image: '/images/Service_1.jpg',
    imageAlt: 'We Move Mobile Homes - Single and twin unit mobile home low loader transport',
    tag: 'Single & Twin Units',
    description:
      'Relocating your mobile home is simple with our complete removal and delivery service. We can manage the entire process, ensuring a smooth transition to your new location. Our experienced team specialises in the safe and efficient transport of single and twin unit mobile homes. For twin units, we offer a splitting and sheeting service, preparing them for transport and reassembly. We are also able to provide responsible disposal of old or unwanted mobile homes, adhering to all UK environmental regulations.',
    points: [
      'Single Unit Transport',
      'Twin Unit Splitting, Sheeting & Reassembly',
      'Site Removal & Precision Pitch Siting',
      'Responsible Demolition & Disposal'
    ]
  },
  {
    id: 'touring-caravans',
    title: 'Touring Caravans',
    image: '/images/tc.jpg',
    imageAlt: 'We Move Mobile Homes - Touring caravan transport collection and delivery',
    tag: 'UK & Europe Transit',
    description:
      'Touring caravan transport across the UK and mainland Europe is our speciality. We offer a reliable and efficient delivery service, handling everything from collection to final placement. Our experienced drivers are fully insured and equipped to transport your caravan safely and securely. Whether it\'s a local move or a trip abroad, we\'ll ensure your caravan arrives at its destination in perfect condition. We cater to all caravan sizes and offer flexible scheduling to suit your needs.',
    points: [
      'Collection & Professional Pre-Trip Inspection',
      'Transport (Local, UK Nationwide & European Travel)',
      'Delivery & Final Placement on Pitch',
      'Flexible Scheduling for All Caravan Sizes'
    ]
  },
  {
    id: 'abnormal-loads',
    title: 'Abnormal Loads & Low Loader Haulage',
    image: '/images/Service_3.jpg',
    imageAlt: 'We Move Mobile Homes - Abnormal loads and low loader heavy haulage',
    tag: 'Permits & Hiab Crane Hire',
    description:
      'Specialising in abnormal loads, oversized loads, and general low loader haulage, we offer comprehensive haulage solutions across the UK. Our fleet of modern, well-maintained vehicles and experienced drivers ensure the safe and efficient transport of your goods, whatever their size or complexity. From construction equipment to industrial machinery, we handle it all. Crucially, we manage all necessary movement orders and arrange permits with the relevant authorities.',
    points: [
      'Abnormal Loads (Over-Width & Abnormal Length)',
      'Low Loader Step-Frame Haulage',
      'Hiab Crane Hire & Precision Lifting Service',
      'Movement Orders & Police / ESDAL Permits Arranged'
    ]
  }
];
---

<section id="services" class="py-16 sm:py-20 lg:py-24 bg-slate-50 border-b border-slate-200/80">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-red-600 shadow-xs mb-3">
        <span>Live Haulage & Siting Solutions</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight mb-4">
        Our Core Transport Services
      </h2>
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
        Direct from our operations hub, we provide turnkey solutions matching the exact services featured on <a href="https://wemovemobilehomes.co.uk/services" target="_blank" rel="noopener noreferrer" class="text-red-600 underline font-semibold hover:text-red-700">wemovemobilehomes.co.uk/services</a>.
      </p>
    </div>

    <!-- 3 Visual Service Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <article class="bg-white rounded-2xl border border-slate-200 shadow-xs hover:shadow-xl hover:border-slate-300 transition-all duration-300 flex flex-col overflow-hidden group">
          <!-- Card Image Header -->
          <div class="relative overflow-hidden aspect-[4/3] bg-slate-100">
            <img
              src={service.image}
              alt={service.imageAlt}
              width="600"
              height="450"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute top-3 left-3">
              <span class="inline-flex rounded-lg bg-white/95 backdrop-blur-xs px-3 py-1 text-xs font-extrabold text-slate-800 shadow-sm border border-slate-200/80">
                {service.tag}
              </span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-black text-slate-900 mb-3 group-hover:text-red-600 transition-colors">
                {service.title}
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                {service.description}
              </p>

              <!-- Service Checklist -->
              <ul class="space-y-2.5 mb-6 border-t border-slate-100 pt-5">
                {service.points.map((point) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm font-semibold text-slate-700">
                    <svg class="h-4 w-4 text-red-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Card Bottom Action -->
            <div class="pt-2 border-t border-slate-100 mt-auto flex flex-col sm:flex-row items-center gap-2.5">
              <a
                href="#quote"
                class="w-full sm:flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-3 text-xs sm:text-sm font-bold text-white transition-all hover:bg-red-600 active:scale-98 shadow-xs"
              >
                <span>Get Quote For This</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href="tel:+441474444081"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-3 text-xs font-bold text-slate-700 transition hover:bg-slate-100 hover:text-slate-900"
                title="Call 01474 444081 to discuss this service"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>01474 444081</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
