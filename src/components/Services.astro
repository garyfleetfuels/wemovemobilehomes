---
const services = [
  {
    id: 'park-homes',
    title: 'Single & Twin-Unit Park Homes',
    subtitle: 'Siting, Levelling, Jacks & De-Rigging',
    description: 'Turnkey relocation for residential park homes and luxury twin lodges. We coordinate full de-siting, axle inspection, secure transit in matched sections, and laser-guided pitch levelling with high-capacity axle stands and chassis jacks.',
    badge: 'Specialist Siting',
    badgeClass: 'border-amber-500/30 bg-amber-500/10 text-amber-300',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
    highlights: [
      'Twin-Unit Joint Alignment & Seal',
      'Hydraulic Jacking & Axle Stands',
      'Laser-Guided Concrete Pad Levelling',
      'Full De-Rigging & Site Clearance'
    ]
  },
  {
    id: 'static-caravans',
    title: 'Static Caravans & Holiday Lodges',
    subtitle: '10ft, 12ft, 13ft & 14ft+ Wide Relocations',
    description: 'Expert haulage for all standard and wide holiday homes. Whether transferring between holiday parks, dealership deliveries, or private plot relocations, we guarantee safe, damage-free transit on our low-clearance step-frame trailers.',
    badge: 'Core Transport',
    badgeClass: 'border-amber-500/30 bg-amber-500/10 text-amber-300',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h2m-6 0a1 1 0 001-1v-3"/></svg>`,
    highlights: [
      '10ft to 14ft+ Wide Units to 50ft',
      'Holiday Park Delivery & Positioning',
      'Private Land & Farm Transfers',
      'Comprehensive Transit Insurance'
    ]
  },
  {
    id: 'hiab-crane',
    title: 'Hiab Crane Hire & Precision Siting',
    subtitle: 'Difficult Access, Over-Hedge Lifts & Winch-Ins',
    description: 'Truck-mounted high-tonnage Hiab cranes operated by ALLMI & CPCS certified crane supervisors. Essential when holiday park access is restricted by narrow boundaries, steep inclines, tree branches, or waterlogged turf where tractor towing fails.',
    badge: 'Precision Lifting',
    badgeClass: 'border-amber-500/30 bg-amber-500/10 text-amber-300',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>`,
    highlights: [
      'Lifting Over Walls, Hedges & Drains',
      'CPCS & ALLMI Certified Lift Team',
      'Heavy-Duty Winch Ground Positioning',
      'Tandem Lifts & Spreader Beams'
    ]
  },
  {
    id: 'permits-escorts',
    title: 'Abnormal Load Permits & Escorts',
    subtitle: 'ESDAL Notifications, Police Clearance & Pilot Cars',
    description: 'We manage 100% of the statutory legal compliance. Our dispatch office handles Electronic Service Delivery for Abnormal Loads (ESDAL) filings with National Highways, regional police constabularies, and provides Chapter 8 pilot escort vehicles.',
    badge: 'Full Compliance',
    badgeClass: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    highlights: [
      'Statutory ESDAL Authority Filings',
      'Police Force Route Clearance',
      'Chapter 8 High-Visibility Pilot Escorts',
      'Bridge & Swept Path Route Surveys'
    ]
  },
  {
    id: 'failed-move-rescue',
    title: 'Failed Move Rescue & Breakdown Recovery',
    subtitle: 'Taking Over When Previous Hauliers Have Failed',
    description: 'Our rapid-response rescue unit specializes in taking over botched moves, stranded units, seized running gear, chassis failures, or loads abandoned due to lack of police notifications. We deploy winches, dollies, and low loaders to complete the delivery safely.',
    badge: 'Emergency Rescue',
    badgeClass: 'border-red-500/40 bg-red-950/30 text-red-300 font-bold animate-pulse',
    icon: `<svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    highlights: [
      'Stranded Load Fast Recovery',
      'Chassis Buckle & Axle Failure Recovery',
      'Unpermitted Transit Resolution',
      'Direct Dispatch Line: 07764 341657'
    ]
  },
  {
    id: 'nationwide-europe',
    title: 'UK Nationwide & European Transit',
    subtitle: 'England, Wales, Scotland & Mainland Europe',
    description: 'Complete cross-border logistics. We move mobile units throughout the UK mainland and to France, Spain, Ireland, and the Netherlands. We coordinate port stevedoring, roll-on/roll-off ferry clearances, and CMR international transport documentation.',
    badge: 'Cross-Border',
    badgeClass: 'border-amber-500/30 bg-amber-500/10 text-amber-300',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    highlights: [
      'England, Scotland, Wales & Islands',
      'Port Handling & RoRo Ferry Bookings',
      'European Transit (France, Spain, Ireland)',
      'Customs & CMR Paperwork Completed'
    ]
  }
];
---

<section id="services" class="py-20 bg-slate-900/60 border-t border-slate-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-400 mb-3">
        <span>Comprehensive Transport Capabilities</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight mb-4">
        Specialist Transport & Siting Services
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        Whether relocating a single park home, multi-unit holiday development, or rescuing a stranded consignment, our purpose-built fleet and certified operators deliver guaranteed results.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((item) => (
        <article class={`transport-card rounded-2xl p-7 flex flex-col justify-between ${item.id === 'failed-move-rescue' ? 'border-red-500/40 bg-red-950/10 hover:border-red-500' : ''}`}>
          <div>
            <div class="flex items-start justify-between mb-5">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500/15 text-amber-400" set:html={item.icon}>
              </div>
              <span class={`rounded-full border px-3 py-1 text-[11px] font-bold uppercase tracking-wider ${item.badgeClass}`}>
                {item.badge}
              </span>
            </div>

            <h3 class="text-xl font-extrabold text-white mb-1.5 hover:text-amber-400 transition-colors">
              {item.title}
            </h3>
            <p class="text-xs font-bold uppercase tracking-wider text-amber-400/90 mb-3.5">
              {item.subtitle}
            </p>

            <p class="text-slate-300 text-sm leading-relaxed mb-6">
              {item.description}
            </p>
          </div>

          <div class="border-t border-slate-800/80 pt-4 mt-auto">
            <ul class="space-y-2 mb-5">
              {item.highlights.map((highlight) => (
                <li class="flex items-center gap-2 text-xs text-slate-300 font-medium">
                  <span class={`h-1.5 w-1.5 rounded-full ${item.id === 'failed-move-rescue' ? 'bg-red-400' : 'bg-amber-400'}`}></span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>

            <div class="pt-2">
              <a
                href={item.id === 'failed-move-rescue' ? 'tel:+447764341657' : '#contact'}
                class={`w-full inline-flex items-center justify-center gap-2 rounded-lg py-2.5 px-3 text-xs font-bold transition-all ${
                  item.id === 'failed-move-rescue'
                    ? 'bg-red-600 hover:bg-red-500 text-white shadow-md shadow-red-600/30'
                    : 'bg-slate-800 hover:bg-amber-500 hover:text-slate-950 text-slate-200'
                }`}
              >
                <span>{item.id === 'failed-move-rescue' ? 'Call Rescue Hotline: 07764 341657' : 'Enquire About This Service'}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
