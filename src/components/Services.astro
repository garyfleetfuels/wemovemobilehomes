---
const services = [
  {
    id: 'transport',
    title: 'Mobile Home & Static Caravan Transport',
    subtitle: 'UK & International Relocations',
    description: 'Specialist transportation for single units, twin units, luxury lodges, and residential park homes. We coordinate the full journey from collection to destination with insured transit across the UK mainland and European routes.',
    badge: 'Core Specialist',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h2m-6 0a1 1 0 001-1v-3"/></svg>`,
    highlights: ['Single & Twin-Unit Lodges', 'Residential Park Homes', 'Holiday Park Relocations', 'Port & Ferry Crossings']
  },
  {
    id: 'low-loader',
    title: 'Specialist Low Loader Haulage',
    subtitle: 'Engineered for Wide & Overlength Loads',
    description: 'Custom extendable step-frame trailers and ultra-low bed transporters engineered specifically to haul wide static units safely under motorway bridges and through restricted rural corridors.',
    badge: 'Heavy Fleet',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>`,
    highlights: ['Extendable Step-Frames', 'Hydraulic Winch Loading', 'Low Deck Clearance', 'Air Suspension Ride']
  },
  {
    id: 'hiab-crane',
    title: 'Hiab Crane Hire & Precision Siting',
    subtitle: 'Lifting & Challenging Access Offloads',
    description: 'High-capacity truck-mounted Hiab cranes operated by certified CPCS specialists. Ideal for lifting over walls, boundary hedges, soft ground, or tricky holiday park pitches where direct towing is impossible.',
    badge: 'Precision Lifting',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>`,
    highlights: ['CPCS / ALLMI Certified', 'Obstacle Clearance Lifting', 'Pitched Siting & Levelling', 'De-siting Services']
  },
  {
    id: 'permits-escorts',
    title: 'Abnormal Load Permits & Escorts',
    subtitle: 'Full Legal Compliance & Route Escorts',
    description: 'Full regulatory compliance handled in-house. We manage Highways England and local authority notifications, police clearance notifications, comprehensive route surveys, and private pilot vehicle escorts.',
    badge: 'Full Compliance',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    highlights: ['Electronic Service Delivery for Abnormal Loads (ESDAL)', 'Police Force Notifications', 'Pilot Escort Vehicles', 'Swept Path Route Surveys']
  },
  {
    id: 'emergency-rescue',
    title: 'Emergency & Failed Transport Rescue',
    subtitle: 'Stranded Load & Breakdown Recovery',
    description: 'Rapid response recovery for stuck, damaged, or unpermitted mobile homes across the UK. Equipped with high-tonnage winches and dollies for seized running gear, chassis fractures, or carrier breakdowns.',
    badge: 'Rapid Response',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    highlights: ['Stranded Unit Mobilization', 'Chassis Fracture Support', 'Seized Axle Recovery', 'Emergency Permits']
  },
  {
    id: 'touring-commercial',
    title: 'Touring Caravan & Commercial Trailer Logistics',
    subtitle: 'UK Nationwide & European Transit',
    description: 'Specialist transportation for luxury touring caravans, commercial catering pods, and modular accommodation units. Full international port clearance, CMR documentation, and ferry crossings arranged.',
    badge: 'UK & Europe',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    highlights: ['Ferry & Port Handling', 'Commercial Accommodation', 'Full CMR Documentation', 'Door-to-Door Delivery']
  }
];
---

<section id="services" class="py-20 bg-slate-900/50 border-t border-slate-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest font-bold text-amber-500 mb-3">Our Core Capabilities</h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Engineered for Heavy, Wide & Abnormal Loads
      </p>
      <p class="text-slate-400 text-base sm:text-lg">
        From single holiday home relocations to multi-unit residential developments, our purpose-built fleet and experienced operators guarantee safe, compliant delivery.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map((item) => (
        <article class="group relative rounded-2xl border border-slate-800 bg-slate-950/70 p-8 transition-all duration-300 hover:border-amber-500/50 hover:bg-slate-900/80 hover:shadow-xl hover:shadow-amber-500/5">
          <div class="flex items-start justify-between mb-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500/10 text-amber-400 group-hover:bg-amber-500 group-hover:text-slate-950 transition-colors duration-200" set:html={item.icon}>
            </div>
            <span class="rounded-full border border-slate-700 bg-slate-800/80 px-3 py-1 text-xs font-semibold text-slate-300">
              {item.badge}
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-white mb-1 group-hover:text-amber-400 transition-colors">
            {item.title}
          </h3>
          <p class="text-xs font-semibold uppercase tracking-wider text-amber-500/90 mb-4">
            {item.subtitle}
          </p>

          <p class="text-slate-400 text-sm leading-relaxed mb-6">
            {item.description}
          </p>

          <div class="border-t border-slate-800/80 pt-4">
            <div class="grid grid-cols-2 gap-2">
              {item.highlights.map((highlight) => (
                <div class="flex items-center gap-2 text-xs text-slate-300 font-medium">
                  <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                  <span>{highlight}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
