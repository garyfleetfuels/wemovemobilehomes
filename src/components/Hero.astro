---
---

<section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
  <!-- Ambient background glow & grid effect -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center">
    <div class="h-[550px] w-[750px] rounded-full bg-gradient-to-tr from-amber-500/15 via-sky-600/10 to-transparent blur-3xl"></div>
  </div>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-1.5 text-xs sm:text-sm font-medium text-amber-400 mb-6 backdrop-blur-sm shadow-inner">
        <span class="flex h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Trusted UK & European Abnormal Load Logistics</span>
      </div>

      <!-- Main Headline / Company Name -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white mb-6">
        <span class="block">We Move</span>
        <span class="bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500 bg-clip-text text-transparent">
          Mobile Homes
        </span>
      </h1>

      <!-- Strapline -->
      <p class="text-xl sm:text-2xl lg:text-3xl font-semibold text-slate-200 tracking-tight mb-8">
        Specialist Mobile Home, Static Caravan & Park Home Transport
      </p>

      <!-- Business Scope / Lead text -->
      <p class="text-base sm:text-lg lg:text-xl text-slate-400 max-w-3xl mx-auto leading-relaxed mb-10">
        Providing end-to-end heavy haulage solutions across the UK and internationally. Our turnkey service encompasses 
        <strong class="text-slate-200 font-semibold">UK & International transport</strong>, 
        <strong class="text-slate-200 font-semibold">Hiab crane hire & precision siting</strong>, 
        <strong class="text-slate-200 font-semibold">specialist low loader haulage</strong>, and comprehensive 
        <strong class="text-slate-200 font-semibold">abnormal load permits & pilot escorts</strong>.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a
          href="#contact"
          id="hero-primary-cta"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-amber-500 px-8 py-4 text-base font-bold text-slate-950 shadow-lg shadow-amber-500/25 transition-all duration-200 hover:bg-amber-400 hover:shadow-xl hover:shadow-amber-500/35 hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Request Transport Quote</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>

        <a
          href="#services"
          id="hero-secondary-cta"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-900/80 px-8 py-4 text-base font-semibold text-slate-200 backdrop-blur-sm transition-all duration-200 hover:border-slate-500 hover:bg-slate-800/80 hover:text-white hover:-translate-y-0.5"
        >
          <span>Explore Specialist Services</span>
        </a>
      </div>

      <!-- Capability Feature Highlights -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-left border-t border-slate-800/80 pt-10">
        <div class="rounded-xl border border-slate-800/80 bg-slate-900/40 p-4 backdrop-blur-xs">
          <div class="text-amber-400 font-bold text-lg mb-1">UK & Overseas</div>
          <div class="text-xs text-slate-400">Nationwide point-to-point and international ferry crossings</div>
        </div>
        <div class="rounded-xl border border-slate-800/80 bg-slate-900/40 p-4 backdrop-blur-xs">
          <div class="text-amber-400 font-bold text-lg mb-1">Hiab Crane Fleet</div>
          <div class="text-xs text-slate-400">Truck-mounted cranes for precision siting & complex offloads</div>
        </div>
        <div class="rounded-xl border border-slate-800/80 bg-slate-900/40 p-4 backdrop-blur-xs">
          <div class="text-amber-400 font-bold text-lg mb-1">Step Frame Trailers</div>
          <div class="text-xs text-slate-400">Purpose-built low loaders designed specifically for static units</div>
        </div>
        <div class="rounded-xl border border-slate-800/80 bg-slate-900/40 p-4 backdrop-blur-xs">
          <div class="text-amber-400 font-bold text-lg mb-1">Permits & Escorts</div>
          <div class="text-xs text-slate-400">Full police notifications, route planning & escort vehicles</div>
        </div>
      </div>
    </div>
  </div>
</section>
