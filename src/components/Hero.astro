---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/sidefpg.jpg';
---

<section id="overview" class="relative overflow-hidden bg-white py-12 sm:py-16 lg:py-20 border-b border-slate-200/80">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7">
        <!-- Trust Pill (High-contrast WCAG AA compliant) -->
        <div class="inline-flex items-center gap-2 rounded-full border border-red-300 bg-red-100 px-3.5 py-1.5 text-xs font-extrabold text-red-900 mb-6 shadow-xs">
          <span class="flex h-2 w-2 rounded-full bg-red-700"></span>
          <span>UK Nationwide & European Specialist Transport</span>
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 leading-[1.1] mb-5">
          We Move <span class="text-red-700">Mobile Homes</span>
        </h1>
        <p class="text-lg sm:text-xl font-extrabold text-slate-800 tracking-tight mb-5">
          Specialist Mobile Home, Static Caravan & Abnormal Load Haulage
        </p>

        <!-- Trust Statement -->
        <p class="text-base sm:text-lg text-slate-700 leading-relaxed max-w-2xl mb-8 font-normal">
          Relocating your mobile home, static caravan, or park home is simple and stress-free with our expert team. We manage the complete process from end to end—safe road transport, splitting and sheeting twin units, abnormal load permits, police notifications, Hiab crane lifting, and precision siting.
        </p>

        <!-- Immediate Action CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-8">
          <a
            href="#quote"
            id="hero-quote-btn"
            class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-red-600 px-7 py-3.5 text-base font-extrabold text-white shadow-md shadow-red-600/20 transition-all hover:bg-red-700 hover:shadow-lg active:scale-98"
          >
            <span>Get a Fast Quote</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>

          <a
            href="tel:+441474444081"
            id="hero-call-btn"
            class="inline-flex items-center justify-center gap-2.5 rounded-xl border-2 border-slate-300 bg-white px-6 py-3.5 text-base font-bold text-slate-900 transition-all hover:border-slate-400 hover:bg-slate-50 active:scale-98 shadow-xs"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call: 01474 444081</span>
          </a>
        </div>

        <!-- Key Trust Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-6 border-t border-slate-200">
          <div class="flex items-center gap-2 text-xs font-bold text-slate-900">
            <svg class="h-4 w-4 text-emerald-800 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Fully Insured In-Transit</span>
          </div>

          <div class="flex items-center gap-2 text-xs font-bold text-slate-900">
            <svg class="h-4 w-4 text-emerald-800 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>ESDAL & Police Escorts</span>
          </div>

          <div class="flex items-center gap-2 text-xs font-bold text-slate-900 col-span-2 sm:col-span-1">
            <svg class="h-4 w-4 text-emerald-800 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Direct with Gary Turner</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Optimized Real Transport Photo (LCP) -->
      <div class="lg:col-span-5">
        <div class="relative">
          <!-- Main transport image optimized with Astro Image -->
          <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-xl">
            <Image
              src={heroImage}
              alt="We Move Mobile Homes specialist low loader transport on highway"
              width={720}
              height={450}
              widths={[360, 540, 720, 960]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 600px"
              format="webp"
              quality={80}
              loading="eager"
              fetchpriority="high"
              class="w-full h-[280px] sm:h-[380px] object-cover transition-transform duration-500 hover:scale-[1.02]"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent pointer-events-none"></div>

            <!-- Floating verification badge -->
            <div class="absolute bottom-4 left-4 right-4 rounded-xl bg-white/95 backdrop-blur-md p-3.5 shadow-lg border border-slate-200/90">
              <div class="flex items-center justify-between gap-2">
                <div>
                  <div class="text-xs font-black text-slate-900">Heavy & Abnormal Haulage Fleet</div>
                  <div class="text-[11px] text-slate-700 font-medium">Step-frame low loaders, Hiab cranes & pilot vehicles</div>
                </div>
                <div class="flex items-center gap-1 text-[11px] font-extrabold text-red-900 shrink-0 bg-red-100 border border-red-300 px-2 py-1 rounded">
                  <span>07764 341657</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
