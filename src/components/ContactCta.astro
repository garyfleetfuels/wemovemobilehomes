---
---

<section id="quote" class="py-16 sm:py-20 lg:py-24 bg-white relative">
  <!-- Anchor alias for #contact compatibility -->
  <div id="contact" class="absolute -top-16 left-0"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Gary Turner Direct Dispatch & Reassurance -->
      <div class="lg:col-span-5">
        <div class="inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-red-700 mb-4">
          <span>Fast, Direct Response</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight mb-4">
          Get Your Move Quote
        </h2>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-8">
          No automated phone trees or call centres. Every move is planned and priced directly by operator <strong class="text-slate-900">Gary Turner</strong>. Complete the quick details or call Gary directly right now.
        </p>

        <!-- Direct Contact Cards -->
        <div class="space-y-4 mb-8">
          <!-- Landline Office -->
          <a
            href="tel:+441474444081"
            class="flex items-center gap-4 p-4 rounded-2xl border border-slate-200 bg-slate-50 hover:border-red-500 hover:bg-white hover:shadow-md transition-all group"
          >
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-600 text-white font-black shadow-xs">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Main Dispatch Office</div>
              <div class="font-black text-slate-900 text-xl group-hover:text-red-600 transition-colors">01474 444081</div>
              <div class="text-xs text-slate-500 font-medium">Mon–Fri: 8:00am – 6:00pm</div>
            </div>
          </a>

          <!-- Gary Turner Mobile -->
          <a
            href="tel:+447764341657"
            class="flex items-center gap-4 p-4 rounded-2xl border border-slate-200 bg-slate-50 hover:border-red-500 hover:bg-white hover:shadow-md transition-all group"
          >
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-900 text-white font-black group-hover:bg-red-600 transition-colors shadow-xs">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Direct Operator Mobile (Gary Turner)</div>
              <div class="font-black text-slate-900 text-xl group-hover:text-red-600 transition-colors">07764 341657</div>
              <div class="text-xs text-emerald-600 font-semibold">One-Tap Direct Call • Fast Callback</div>
            </div>
          </a>

          <!-- Email -->
          <a
            href="mailto:info@wemovemobilehomes.co.uk"
            class="flex items-center gap-4 p-4 rounded-2xl border border-slate-200 bg-slate-50 hover:border-red-500 hover:bg-white hover:shadow-md transition-all group"
          >
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-200 text-slate-700 group-hover:bg-red-600 group-hover:text-white transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Email Quotations</div>
              <div class="font-bold text-slate-900 text-sm sm:text-base group-hover:text-red-600 transition-colors">info@wemovemobilehomes.co.uk</div>
              <div class="text-xs text-slate-500">Send specs, photos, or park site maps</div>
            </div>
          </a>
        </div>

        <!-- Trust Features -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 space-y-2.5 text-xs text-slate-600">
          <div class="flex items-center gap-2 font-bold text-slate-800">
            <svg class="h-4 w-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Complete UK Nationwide & European Coverage</span>
          </div>
          <div class="flex items-center gap-2 font-bold text-slate-800">
            <svg class="h-4 w-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Abnormal Movement Orders & Escorts Arranged</span>
          </div>
          <div class="flex items-center gap-2 font-bold text-slate-800">
            <svg class="h-4 w-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Twin Unit Splitting, Sheeting & Pitch Reassembly</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Gary Turner's Streamlined Intake Form Card -->
      <div class="lg:col-span-7">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 lg:p-10 shadow-xl shadow-slate-900/5 relative">
          <!-- Form Header -->
          <div class="border-b border-slate-100 pb-5 mb-6">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-2xl font-black text-slate-900">
                  Quick Transport Quote Form
                </h3>
                <p class="text-sm text-slate-500 mt-1">
                  Fill in your move details below for an accurate, fast callback and price.
                </p>
              </div>
              <span class="hidden sm:inline-flex rounded-full bg-red-50 border border-red-200 px-3 py-1 text-xs font-bold text-red-600">
                100% Free & No Obligation
              </span>
            </div>
          </div>

          <form id="streamlined-quote-form" class="space-y-6">
            <!-- 1. Dimensions Group -->
            <div>
              <label class="block text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-2">
                1. Unit Dimensions
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="quote-width" class="block text-xs font-semibold text-slate-600 mb-1">
                    Width *
                  </label>
                  <input
                    type="text"
                    id="quote-width"
                    name="width"
                    required
                    placeholder="e.g. 10ft, 12ft, 14ft, 20ft"
                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm sm:text-base text-slate-900 placeholder-slate-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-100 transition-all font-medium"
                  />
                </div>
                <div>
                  <label for="quote-length" class="block text-xs font-semibold text-slate-600 mb-1">
                    Length *
                  </label>
                  <input
                    type="text"
                    id="quote-length"
                    name="length"
                    required
                    placeholder="e.g. 36ft, 40ft, 50ft"
                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm sm:text-base text-slate-900 placeholder-slate-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-100 transition-all font-medium"
                  />
                </div>
              </div>
            </div>

            <!-- 2. Journey Locations -->
            <div>
              <label class="block text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-2">
                2. Journey Route
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="quote-collection" class="block text-xs font-semibold text-slate-600 mb-1">
                    Collection Postcode / Town (From) *
                  </label>
                  <input
                    type="text"
                    id="quote-collection"
                    name="collection"
                    required
                    placeholder="e.g. NR29 4HY or Great Yarmouth"
                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm sm:text-base text-slate-900 placeholder-slate-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-100 transition-all font-medium"
                  />
                </div>
                <div>
                  <label for="quote-delivery" class="block text-xs font-semibold text-slate-600 mb-1">
                    Delivery Postcode / Town (To) *
                  </label>
                  <input
                    type="text"
                    id="quote-delivery"
                    name="delivery"
                    required
                    placeholder="e.g. TR12 6PG or Helston"
                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm sm:text-base text-slate-900 placeholder-slate-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-100 transition-all font-medium"
                  />
                </div>
              </div>
            </div>

            <!-- 3. Contact Details -->
            <div>
              <label class="block text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-2">
                3. Your Contact Details
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="quote-name" class="block text-xs font-semibold text-slate-600 mb-1">
                    Your Name *
                  </label>
                  <input
                    type="text"
                    id="quote-name"
                    name="name"
                    required
                    placeholder="e.g. John Smith"
                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm sm:text-base text-slate-900 placeholder-slate-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-100 transition-all font-medium"
                  />
                </div>
                <div>
                  <label for="quote-phone" class="block text-xs font-bold text-slate-900 mb-1">
                    Phone Number (Primary Contact Method) *
                  </label>
                  <input
                    type="tel"
                    id="quote-phone"
                    name="phone"
                    required
                    placeholder="e.g. 07700 900123"
                    class="w-full rounded-xl border-2 border-red-500 bg-white px-4 py-3 text-sm sm:text-base text-slate-900 placeholder-slate-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-200 transition-all font-bold"
                  />
                  <span class="block text-[11px] text-slate-500 mt-1">Gary Turner will call you directly on this number</span>
                </div>
              </div>
              <div class="mt-3">
                <label for="quote-email" class="block text-xs font-semibold text-slate-600 mb-1">
                  Email Address (Optional)
                </label>
                <input
                  type="email"
                  id="quote-email"
                  name="email"
                  placeholder="e.g. name@example.com (optional)"
                  class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm sm:text-base text-slate-900 placeholder-slate-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-100 transition-all font-medium"
                />
              </div>
            </div>

            <!-- 4. Access Restrictions & Siting (Interactive Question) -->
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
              <label class="block text-sm font-extrabold text-slate-900 mb-2">
                4. Access Restrictions & Siting
              </label>
              <p class="text-xs sm:text-sm text-slate-600 mb-4">
                Any narrow lanes, tight corners, soft ground, low bridges, or steep slopes?
              </p>

              <!-- Radio / Toggle buttons -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                <label
                  id="label-access-no"
                  class="flex items-center gap-3 p-3.5 rounded-xl border-2 border-slate-300 bg-white cursor-pointer hover:border-slate-400 transition-all text-sm font-bold text-slate-800"
                >
                  <input
                    type="radio"
                    name="access_restrictions"
                    id="access-no"
                    value="no"
                    checked
                    class="h-4 w-4 text-red-600 focus:ring-red-500 border-slate-300"
                  />
                  <span>No — Access is clear</span>
                </label>

                <label
                  id="label-access-yes"
                  class="flex items-center gap-3 p-3.5 rounded-xl border-2 border-slate-300 bg-white cursor-pointer hover:border-slate-400 transition-all text-sm font-bold text-slate-800"
                >
                  <input
                    type="radio"
                    name="access_restrictions"
                    id="access-yes"
                    value="yes"
                    class="h-4 w-4 text-red-600 focus:ring-red-500 border-slate-300"
                  />
                  <span>Yes — There are restrictions</span>
                </label>
              </div>

              <!-- Interactive Confirmation Banners -->
              
              <!-- When "No" is selected (Default) -->
              <div id="banner-access-no" class="flex items-start gap-2.5 rounded-xl bg-emerald-50 border border-emerald-200 p-3.5 text-xs sm:text-sm text-emerald-800 font-semibold">
                <svg class="h-5 w-5 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>I confirm access is clear at both ends for a low loader / transport vehicle.</span>
              </div>

              <!-- When "Yes" is selected -->
              <div id="banner-access-yes" class="hidden rounded-xl bg-amber-50 border-2 border-amber-300 p-4 text-xs sm:text-sm text-amber-950 font-medium space-y-3">
                <div class="flex items-start gap-2.5 font-bold text-amber-900">
                  <svg class="h-5 w-5 text-amber-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  <span>Access restrictions require route planning. You can submit your details below or call Gary directly right now to discuss.</span>
                </div>
                <div>
                  <a
                    href="tel:+447764341657"
                    class="inline-flex items-center gap-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-extrabold px-4 py-2 text-xs sm:text-sm shadow-xs transition-colors"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    <span>Call Gary Now: 07764 341657</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Submit Action -->
            <div class="pt-2">
              <button
                type="submit"
                id="submit-quote-btn"
                class="w-full rounded-2xl bg-red-600 hover:bg-red-700 active:bg-red-800 text-white py-4 px-6 text-center text-base sm:text-lg font-black shadow-lg shadow-red-600/25 transition-all active:scale-[0.99] cursor-pointer"
              >
                Request Fast Callback & Quote
              </button>
              <div class="flex items-center justify-center gap-2 text-xs text-slate-500 mt-3 text-center">
                <svg class="h-4 w-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Direct operator review by Gary Turner • Free & no obligation</span>
              </div>
            </div>
          </form>

          <!-- Interactive Success Message (hidden by default) -->
          <div id="quote-success-msg" class="hidden rounded-2xl bg-emerald-50 border-2 border-emerald-300 p-6 text-center space-y-3 mt-6">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-emerald-600 text-white mb-2">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h4 class="text-xl font-black text-emerald-950">
              Thank You! Quote Request Received
            </h4>
            <p class="text-sm text-emerald-800 max-w-md mx-auto">
              Gary Turner has received your transport details and will call you on your phone number shortly with your price and route assessment.
            </p>
            <div class="pt-2">
              <a
                href="tel:+447764341657"
                class="inline-flex items-center gap-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white px-5 py-2.5 text-sm font-bold shadow-xs transition-colors"
              >
                <span>Call Gary Directly: 07764 341657</span>
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Access Restriction interactive toggle
  const radioNo = document.getElementById('access-no') as HTMLInputElement | null;
  const radioYes = document.getElementById('access-yes') as HTMLInputElement | null;
  const bannerNo = document.getElementById('banner-access-no');
  const bannerYes = document.getElementById('banner-access-yes');
  const labelNo = document.getElementById('label-access-no');
  const labelYes = document.getElementById('label-access-yes');

  function updateAccessBanners() {
    if (radioYes && radioYes.checked) {
      bannerYes?.classList.remove('hidden');
      bannerNo?.classList.add('hidden');
      labelYes?.classList.add('border-red-600', 'bg-red-50/30');
      labelNo?.classList.remove('border-red-600', 'bg-red-50/30');
    } else {
      bannerNo?.classList.remove('hidden');
      bannerYes?.classList.add('hidden');
      labelNo?.classList.add('border-emerald-600', 'bg-emerald-50/30');
      labelYes?.classList.remove('border-emerald-600', 'bg-emerald-50/30');
    }
  }

  radioNo?.addEventListener('change', updateAccessBanners);
  radioYes?.addEventListener('change', updateAccessBanners);
  updateAccessBanners();

  // Quote Form Submission Handling
  const quoteForm = document.getElementById('streamlined-quote-form') as HTMLFormElement | null;
  const successBox = document.getElementById('quote-success-msg');

  if (quoteForm && successBox) {
    quoteForm.addEventListener('submit', (e) => {
      e.preventDefault();
      // Smoothly hide form and show success message
      quoteForm.classList.add('hidden');
      successBox.classList.remove('hidden');
      successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>
