---
---

<section id="contact" class="py-20 bg-slate-900 border-t border-slate-800 relative">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Contact Info -->
      <div class="lg:col-span-5">
        <span class="text-xs uppercase tracking-widest font-bold text-amber-500 mb-2 block">Direct Quotation Request</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          Need Your Mobile Home or Static Caravan Moved?
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
          Speak directly with our transport dispatchers. We calculate optimal routes, manage abnormal load permits, and supply turnkey haulage with optional Hiab crane lifting.
        </p>

        <div class="space-y-4">
          <div class="flex items-center gap-4 p-4 rounded-xl border border-slate-800 bg-slate-950/60">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-500/10 text-amber-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-xs text-slate-400">UK Dispatch & Enquiries</div>
              <div class="font-bold text-white text-base">+44 (0) 800 000 0000</div>
            </div>
          </div>

          <div class="flex items-center gap-4 p-4 rounded-xl border border-slate-800 bg-slate-950/60">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-500/10 text-amber-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-xs text-slate-400">Email Quotations</div>
              <div class="font-bold text-white text-base">info@wemovemobilehomes.co.uk</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quote Request Form -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-slate-800 bg-slate-950 p-6 sm:p-8 shadow-xl">
          <h3 class="text-xl font-bold text-white mb-2">Transport Quote Calculator</h3>
          <p class="text-xs sm:text-sm text-slate-400 mb-6">Enter transport coordinates and dimensions for a rapid rate calculation.</p>

          <form id="quote-request-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-semibold text-slate-300 mb-1">Contact Name *</label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. John Smith"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
              <div>
                <label for="contact-phone" class="block text-xs font-semibold text-slate-300 mb-1">Phone Number *</label>
                <input
                  type="tel"
                  id="contact-phone"
                  name="phone"
                  required
                  placeholder="e.g. 07123 456789"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="collection-postcode" class="block text-xs font-semibold text-slate-300 mb-1">Collection Location / Postcode *</label>
                <input
                  type="text"
                  id="collection-postcode"
                  name="collection"
                  required
                  placeholder="e.g. NR29 4HY (Norfolk)"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
              <div>
                <label for="delivery-postcode" class="block text-xs font-semibold text-slate-300 mb-1">Delivery Location / Postcode *</label>
                <input
                  type="text"
                  id="delivery-postcode"
                  name="delivery"
                  required
                  placeholder="e.g. TR12 6PG (Cornwall)"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="unit-size" class="block text-xs font-semibold text-slate-300 mb-1">Unit Dimensions (Length x Width)</label>
                <input
                  type="text"
                  id="unit-size"
                  name="size"
                  placeholder="e.g. 35ft x 12ft"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
              <div>
                <label for="service-type" class="block text-xs font-semibold text-slate-300 mb-1">Service Required</label>
                <select
                  id="service-type"
                  name="service"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                >
                  <option value="standard-transport">Mobile Home / Static Caravan Transport</option>
                  <option value="hiab-crane">Hiab Crane Offload & Siting</option>
                  <option value="abnormal-escort">Wide Load Haulage & Escorts</option>
                  <option value="international">European / International Transport</option>
                </select>
              </div>
            </div>

            <div>
              <label for="notes" class="block text-xs font-semibold text-slate-300 mb-1">Additional Notes / Access Obstacles</label>
              <textarea
                id="notes"
                name="notes"
                rows="3"
                placeholder="Details on tight access, tree branches, uneven ground, or preferred dates..."
                class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submit-quote-btn"
              class="w-full rounded-xl bg-amber-500 py-3.5 px-4 text-center text-sm font-bold text-slate-950 shadow-lg shadow-amber-500/20 transition hover:bg-amber-400 active:scale-[0.99]"
            >
              Submit Quote Request
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const quoteForm = document.getElementById('quote-request-form') as HTMLFormElement | null;
  if (quoteForm) {
    quoteForm.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thank you! A We Move Mobile Homes transport coordinator will contact you with a detailed quote.');
      quoteForm.reset();
    });
  }
</script>
