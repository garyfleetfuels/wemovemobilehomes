---
---

<section id="contact" class="py-20 bg-slate-900 border-t border-slate-800 relative">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Contact Info & Direct Dispatch -->
      <div class="lg:col-span-5">
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-400 mb-3">
          <span>Direct Dispatch & Rates</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight mb-4">
          Arrange Movement of Your Mobile Home
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
          Speak directly with our transport dispatchers or complete the form for a rapid route and haulage rate calculation. We survey the route, secure statutory abnormal load permits, and deliver turnkey relocation with precision siting.
        </p>

        <!-- Direct Contact Cards -->
        <div class="space-y-4 mb-8">
          <!-- Telephone Click to Call -->
          <a
            href="tel:+447764341657"
            class="flex items-center gap-4 p-4 rounded-xl border border-slate-800 bg-[#0b1120] hover:border-amber-500/60 hover:bg-slate-900 transition-all duration-200 group"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500/10 text-amber-400 group-hover:bg-amber-500 group-hover:text-slate-950 transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Direct Dispatch & Emergency Hotline</div>
              <div class="font-black text-white text-lg group-hover:text-amber-400 transition-colors">07764 341657</div>
              <div class="text-[11px] text-emerald-400 font-medium">Click to Call Directly • Mon–Fri 8am–6pm (24/7 Rescue)</div>
            </div>
          </a>

          <!-- Email Click to Email -->
          <a
            href="mailto:info@wemovemobilehomes.co.uk"
            class="flex items-center gap-4 p-4 rounded-xl border border-slate-800 bg-[#0b1120] hover:border-amber-500/60 hover:bg-slate-900 transition-all duration-200 group"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500/10 text-amber-400 group-hover:bg-amber-500 group-hover:text-slate-950 transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Email Quotations</div>
              <div class="font-black text-white text-base group-hover:text-amber-400 transition-colors">info@wemovemobilehomes.co.uk</div>
              <div class="text-[11px] text-slate-400 font-medium">Fast written quotations with full RAMS breakdowns</div>
            </div>
          </a>
        </div>

        <!-- Coverage & Operating Hours -->
        <div class="rounded-xl border border-slate-800/80 bg-slate-950/60 p-4 text-xs text-slate-400 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-slate-300">Office Hours:</span>
            <span>Monday – Friday: 08:00 – 18:00</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="font-bold text-slate-300">Emergency Rescue:</span>
            <span class="text-red-400 font-semibold">24/7 Response Available</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="font-bold text-slate-300">Service Coverage:</span>
            <span>UK Nationwide & Mainland Europe</span>
          </div>
        </div>
      </div>

      <!-- Quote Request Form -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-slate-800 bg-[#0b1120] p-6 sm:p-8 shadow-2xl relative">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-xl sm:text-2xl font-black text-white">Transport Quote Calculator</h3>
              <p class="text-xs sm:text-sm text-slate-400 mt-1">Fill in your move details for an exact, comprehensive quote.</p>
            </div>
            <span class="rounded bg-amber-500/10 px-2 py-1 text-[11px] font-bold text-amber-400 border border-amber-500/30 hidden sm:inline">
              Free • No Obligation
            </span>
          </div>

          <form id="quote-request-form" class="space-y-4">
            <!-- Contact Details -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-bold text-slate-300 mb-1">Your Full Name *</label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. David Williams"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
              <div>
                <label for="contact-phone" class="block text-xs font-bold text-slate-300 mb-1">Phone Number *</label>
                <input
                  type="tel"
                  id="contact-phone"
                  name="phone"
                  required
                  placeholder="e.g. 07700 900123"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
            </div>

            <!-- Locations: Pickup & Delivery Postcodes -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="collection-postcode" class="block text-xs font-bold text-slate-300 mb-1">Pickup Location / Postcode *</label>
                <input
                  type="text"
                  id="collection-postcode"
                  name="collection"
                  required
                  placeholder="e.g. NR29 4HY (Norfolk)"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
              <div>
                <label for="delivery-postcode" class="block text-xs font-bold text-slate-300 mb-1">Delivery Location / Postcode *</label>
                <input
                  type="text"
                  id="delivery-postcode"
                  name="delivery"
                  required
                  placeholder="e.g. TR12 6PG (Cornwall)"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
            </div>

            <!-- Unit Dimensions & Preferred Date -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="unit-size" class="block text-xs font-bold text-slate-300 mb-1">Home Dimensions (Length x Width) *</label>
                <input
                  type="text"
                  id="unit-size"
                  name="size"
                  required
                  placeholder="e.g. 38ft x 12ft (or 40ft x 20ft Twin)"
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
              <div>
                <label for="preferred-date" class="block text-xs font-bold text-slate-300 mb-1">Preferred Move Date *</label>
                <input
                  type="date"
                  id="preferred-date"
                  name="preferred_date"
                  required
                  class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
                />
              </div>
            </div>

            <!-- Unit Category / Service Selection -->
            <div>
              <label for="service-type" class="block text-xs font-bold text-slate-300 mb-1">Unit Category & Service Required *</label>
              <select
                id="service-type"
                name="service"
                required
                class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
              >
                <option value="static-caravan">Static Caravan (10ft, 12ft, 13ft, 14ft Wide)</option>
                <option value="twin-unit">Twin-Unit Park Home / Holiday Lodge (Jointed)</option>
                <option value="single-park-home">Single Residential Park Home (BS3632)</option>
                <option value="hiab-lift">Hiab Crane Precision Lifting & Siting Required</option>
                <option value="failed-rescue">Emergency Failed Move Rescue / Breakdown Takeover</option>
                <option value="touring-commercial">Touring Caravan or Commercial Trailer Transport</option>
                <option value="international">European Cross-Border Transport (France, Spain, Ireland, etc.)</option>
              </select>
            </div>

            <!-- Access Obstacles / Notes -->
            <div>
              <label for="notes" class="block text-xs font-bold text-slate-300 mb-1">Access Obstacles / Site Notes</label>
              <textarea
                id="notes"
                name="notes"
                rows="3"
                placeholder="Mention narrow country lanes, tight park turns, low trees, wet soft ground, or whether Hiab over-wall crane offload is needed..."
                class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submit-quote-btn"
              class="w-full rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 py-4 px-6 text-center text-base font-black text-slate-950 shadow-xl shadow-amber-500/25 transition-all hover:from-amber-400 hover:to-amber-500 hover:shadow-2xl active:scale-[0.99]"
            >
              Submit Transport Quote Request
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const quoteForm = document.getElementById('quote-request-form') as HTMLFormElement | null;
  if (quoteForm) {
    quoteForm.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thank you! Your quote request has been received. A We Move Mobile Homes transport coordinator will contact you promptly with your rate calculation.');
      quoteForm.reset();
    });
  }
</script>
