---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

export interface BreadcrumbItem {
  name: string;
  item: string;
}

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  googleSiteVerification?: string;
  gaMeasurementId?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title = 'We Move Mobile Homes | Specialist Mobile Home, Static Caravan & Park Home Transport',
  description = 'We Move Mobile Homes provides nationwide UK and European transport for single & twin unit mobile homes, touring caravans, and abnormal loads. Specialist low loader haulage, Hiab crane lifting, and ESDAL permits. Call 01474 444081 or 07764 341657.',
  canonicalURL = Astro.url.href,
  ogImage = '/images/sidefpg.jpg',
  googleSiteVerification,
  gaMeasurementId,
  breadcrumbs = [
    { name: 'Home', item: Astro.site ? new URL('/', Astro.site).href : 'https://wemovemobilehomes.co.uk/' },
  ],
} = Astro.props;

const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : canonicalURL;
const siteBaseUrl = Astro.site ? new URL('/', Astro.site).href : 'https://wemovemobilehomes.co.uk/';

// Resolve tokens via props or environment variables
const resolvedGoogleSiteVerification = googleSiteVerification || import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const resolvedGaMeasurementId = gaMeasurementId || import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

// Structured Schema.org graph (MovingCompany + AutoTransport + Breadcrumbs)
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["MovingCompany", "AutoTransport"],
      "@id": `${siteBaseUrl}#organization`,
      "name": "We Move Mobile Homes",
      "legalName": "We Move Mobile Homes UK/EU",
      "alternateName": "We Move Mobile Homes",
      "url": siteBaseUrl,
      "logo": {
        "@type": "ImageObject",
        "url": new URL('/images/websitelogocolour2.svg', siteBaseUrl).href,
        "width": 1320,
        "height": 300,
        "caption": "We Move Mobile Homes Logo"
      },
      "image": new URL(ogImage, siteBaseUrl).href,
      "description": description,
      "telephone": ["+441474444081", "+447764341657"],
      "email": "info@wemovemobilehomes.co.uk",
      "priceRange": "£££",
      "currenciesAccepted": "GBP, EUR",
      "paymentAccepted": "Cash, Credit Card, Bank Transfer",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "18:00"
        }
      ],
      "areaServed": [
        {
          "@type": "Country",
          "name": "United Kingdom"
        },
        {
          "@type": "AdministrativeArea",
          "name": "England"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Scotland"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Wales"
        },
        {
          "@type": "Continent",
          "name": "Europe"
        }
      ],
      "knowsAbout": [
        "Moving Mobile Homes & Caravans",
        "Single Unit Mobile Home Transport",
        "Twin Unit Mobile Home Splitting, Sheeting & Reassembly",
        "Site Removal & Demolition Disposal",
        "Touring Caravans Collection & Delivery",
        "Abnormal Loads & Low Loader Haulage",
        "Hiab Crane Hire & Precision Lifting",
        "Police Permits & ESDAL Movement Orders"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "We Move Mobile Homes Transport Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Moving Mobile Homes & Caravans",
              "description": "Safe, efficient transport for single and twin unit mobile homes including splitting and sheeting, site removal, transport, and responsible demolition/disposal."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Touring Caravans Transport",
              "description": "Collection, transport, and delivery across local routes, UK nationwide, and mainland Europe."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Abnormal Loads & Low Loader Haulage",
              "description": "Low loader haulage for over-width, abnormal length loads with Hiab crane hire and full police/ESDAL permit coordination."
            }
          }
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteBaseUrl}#website`,
      "url": siteBaseUrl,
      "name": "We Move Mobile Homes",
      "description": description,
      "publisher": {
        "@id": `${siteBaseUrl}#organization`
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${siteUrl}#breadcrumb`,
      "itemListElement": breadcrumbs.map((crumb, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": crumb.name,
        "item": crumb.item
      }))
    }
  ]
};
---

<!doctype html>
<html lang="en-GB" class="h-full bg-white text-slate-900 antialiased selection:bg-red-600 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Google Site Verification (GSC) -->
    {resolvedGoogleSiteVerification && (
      <meta name="google-site-verification" content={resolvedGoogleSiteVerification} />
    )}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Canonical URL -->
    <link rel="canonical" href={siteUrl} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="mobile home transport, caravan transport, static caravan movers, twin unit mobile home, low loader haulage, hiab crane hire, abnormal loads, touring caravan transport, we move mobile homes, mobile home haulage coordinator" />
    <meta name="author" content="We Move Mobile Homes" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteBaseUrl).href} />
    <meta property="og:site_name" content="We Move Mobile Homes" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, siteBaseUrl).href} />

    <!-- Typography: Non-blocking Preconnected Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Outfit:wght@700;900&display=swap"
      media="print"
      id="gfonts-css"
    />
    <script is:inline>
      const gf = document.getElementById('gfonts-css');
      if (gf) {
        gf.addEventListener('load', function() { this.media = 'all'; });
        if (gf.sheet) gf.media = 'all';
      }
    </script>
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Outfit:wght@700;900&display=swap"
      />
    </noscript>

    <!-- Schema.org JSON-LD (MovingCompany / AutoTransport / BreadcrumbList) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- Google Consent Mode v2 Default Setup (UK GDPR / PECR) -->
    <script is:inline>
      // Establish Google Consent Mode v2 defaults immediately
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }

      const savedConsent = typeof localStorage !== 'undefined' ? localStorage.getItem('cookie_consent') : null;

      if (savedConsent === 'granted') {
        gtag('consent', 'default', {
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted',
          'analytics_storage': 'granted',
          'functionality_storage': 'granted',
          'security_storage': 'granted'
        });
      } else {
        gtag('consent', 'default', {
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'analytics_storage': 'denied',
          'functionality_storage': 'granted',
          'security_storage': 'granted'
        });
      }
    </script>

    <!-- Google Analytics (GA4) / Google Tag Manager -->
    {resolvedGaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${resolvedGaMeasurementId}`}></script>
        <script is:inline define:vars={{ resolvedGaMeasurementId }}>
          gtag('js', new Date());
          gtag('config', resolvedGaMeasurementId);
        </script>
      </>
    )}

    <!-- Page Specific Head Extensions -->
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col bg-white font-sans text-slate-900">
    <slot />
    <CookieConsent />
  </body>
</html>
