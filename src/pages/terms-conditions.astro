---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', item: 'https://wemovemobilehomes.co.uk/' },
  { name: 'Terms & Conditions', item: 'https://wemovemobilehomes.co.uk/terms-conditions' },
];

const clauseSections = [
  { id: 'payment-booking', title: '1. Payment & Booking', range: 'Clauses 1.0 – 3.0' },
  { id: 'collection-delivery', title: '2. Readiness & Delivery', range: 'Clauses 4.0 – 6.0' },
  { id: 'transit-insurance', title: '3. Transit & Insurance', range: 'Clauses 7.0 – 10.0' },
  { id: 'permits-safety', title: '4. Permits & Safety', range: 'Clauses 11.0 – 14.0' },
  { id: 'exclusions-siting', title: '5. Siting & RHA Terms', range: 'Clauses 15.0 – 17.0' },
  { id: 'liability-indemnity', title: '6. Liability & Indemnity', range: 'Clauses 18.0 – 24.0' },
  { id: 'warranties-final', title: '7. Final Contract Terms', range: 'Clauses 25.0 – 28.0' },
];
---

<Layout
  title="Terms & Conditions | We Move Mobile Homes"
  description="Official Terms and Conditions of Carriage for We Move Mobile Homes. Operational guidelines, payment schedules, cancellation tiers, demurrage rates, and RHA Conditions of Carriage."
  canonicalURL="https://wemovemobilehomes.co.uk/terms-conditions"
  breadcrumbs={breadcrumbs}
>
  <Navbar />

  <main id="main-content" class="bg-slate-50 min-h-screen text-slate-800">
    <!-- Breadcrumb & Header Hero -->
    <header class="border-b border-slate-200 bg-white pt-8 pb-10 sm:py-12">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumbs" class="mb-5 flex items-center gap-2 text-xs font-bold text-slate-500">
          <a href="/" class="hover:text-red-700 transition-colors">Home</a>
          <span>/</span>
          <span class="text-slate-900" aria-current="page">Terms & Conditions</span>
        </nav>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-red-300 bg-red-100 px-3.5 py-1 text-xs font-extrabold uppercase tracking-wider text-red-900 mb-3 shadow-xs">
              Contract of Carriage
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
              Terms & Conditions
            </h1>
          </div>

          <!-- Document Metadata & Print Action -->
          <div class="flex flex-col sm:items-end gap-2 text-xs text-slate-600">
            <span class="inline-flex items-center gap-1.5 font-bold text-slate-800 bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Last Updated: 9th February 2024
            </span>
            <span class="text-slate-500 font-medium">We Move Mobile Homes • Registered in England</span>
            <button
              type="button"
              id="print-terms-btn"
              class="inline-flex items-center gap-1.5 font-bold text-red-700 hover:text-red-800 hover:underline mt-1 cursor-pointer"
              title="Print document or save as PDF"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
              </svg>
              Print / Save as PDF
            </button>
          </div>
        </div>

        <p class="mt-6 text-sm sm:text-base text-slate-700 leading-relaxed font-normal border-t border-slate-100 pt-5">
          These Terms and Conditions govern all transport, haulage, siting, de-siting, escort, and logistical services supplied by <strong>We Move Mobile Homes</strong> ("the Company") across the United Kingdom and mainland Europe. By instructing the Company, accepting a quote, or paying a booking deposit, you ("the Customer") agree to be bound by these Terms and the Road Haulage Association (RHA) Conditions of Carriage.
        </p>
      </div>
    </header>

    <!-- Quick Navigation Bar -->
    <div class="sticky top-16 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-xs">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <div class="flex items-center gap-3 overflow-x-auto py-3 no-scrollbar text-xs font-bold text-slate-700">
          <span class="text-slate-400 shrink-0 uppercase tracking-wider text-[11px]">Jump to:</span>
          {clauseSections.map((sec) => (
            <a
              href={`#${sec.id}`}
              class="shrink-0 rounded-lg px-2.5 py-1.5 hover:bg-red-50 hover:text-red-700 transition-colors border border-transparent hover:border-red-200"
            >
              {sec.title}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Main Clauses Body -->
    <div class="mx-auto max-w-4xl px-4 sm:px-6 py-12">
      <div class="space-y-12">

        <!-- ========================================== -->
        <!-- SECTION 1: Payment & Booking (1.0 – 3.0) -->
        <!-- ========================================== -->
        <section id="payment-booking" class="scroll-mt-32 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 lg:p-10 shadow-xs">
          <div class="border-b border-slate-200 pb-4 mb-6">
            <span class="text-xs font-black uppercase tracking-wider text-red-700">Section 1</span>
            <h2 class="text-2xl font-black text-slate-900 mt-1">Payment Terms & Booking Policies</h2>
          </div>

          <div class="space-y-8 text-sm sm:text-base text-slate-700 leading-relaxed">
            <!-- 1.0 Payment Terms -->
            <div>
              <h3 class="text-lg font-black text-slate-900 mb-2">1.0 Payment Terms</h3>
              <p class="mb-3">
                <strong>1.1 Quotations:</strong> All quotations issued by the Company remain valid for thirty (30) days from the date of issue unless otherwise specified in writing. Quotations are formulated based on the dimensions, weight, collection location, and delivery route details provided by the Customer.
              </p>
              
              <!-- CALLOUT: Clause 1.2 -->
              <div class="my-4 rounded-2xl border-2 border-red-500/80 bg-red-50/70 p-4 sm:p-5 text-slate-900">
                <div class="flex items-start gap-3">
                  <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-600 text-white font-black text-xs mt-0.5">
                    !
                  </div>
                  <div class="space-y-2 text-xs sm:text-sm">
                    <h4 class="font-black text-red-950 uppercase tracking-wider text-xs">
                      Clause 1.2 — Booking Deposit & Cancellation Schedule Tiers
                    </h4>
                    <p>
                      A deposit of <strong>25%</strong> of the total quoted price is required upon booking confirmation to secure vehicle allocation, routing slots, and escort scheduling. The remaining balance of <strong>75%</strong> is payable strictly prior to or at the point of vehicle collection.
                    </p>
                    <p class="font-bold text-red-950">
                      Cancellation charges apply in accordance with the following strict schedule:
                    </p>
                    <ul class="list-disc pl-5 space-y-1 font-medium">
                      <li><strong>Notice of 7+ working days prior to collection:</strong> Full refund of deposit less a £75.00 + VAT administrative and route processing fee.</li>
                      <li><strong>Notice of 3 to 7 working days prior to collection:</strong> 50% of the total contract price is due and payable immediately.</li>
                      <li><strong>Notice under 48 hours or day of move:</strong> 100% of the total contract price is payable in full. This applies equally to abortive collections caused by site unreadiness or locked access gates.</li>
                    </ul>
                  </div>
                </div>
              </div>

              <p class="mb-3">
                <strong>1.3 Permitted Payment Methods:</strong> Payment may be made via electronic bank transfer (BACS / CHAPS) or recognized debit/credit cards. Cleared funds must be received prior to unit offloading unless credit terms have been expressly agreed in writing.
              </p>
              <p>
                <strong>1.4 Overdue Sums & Interest:</strong> Interest on overdue accounts shall accrue daily at the rate of 8% per annum above the Bank of England base rate in accordance with the Late Payment of Commercial Debts (Interest) Act 1998, along with statutory debt recovery costs.
              </p>
            </div>

            <!-- 2.0 Collection Readiness -->
            <div class="border-t border-slate-100 pt-6">
              <h3 class="text-lg font-black text-slate-900 mb-2">2.0 Collection Readiness</h3>
              <p class="mb-3">
                <strong>2.1 Customer Readiness Warranty:</strong> The Customer warrants that the mobile home, modular building, or static caravan will be completely disconnected from all mains services, clear of all external obstacles, and structurally fit to be loaded or winched at the scheduled collection arrival time.
              </p>

              <!-- CALLOUT: Clause 2.2 -->
              <div class="my-4 rounded-2xl border-2 border-amber-500/80 bg-amber-50/70 p-4 sm:p-5 text-slate-900">
                <div class="flex items-start gap-3">
                  <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-600 text-white font-black text-xs mt-0.5">
                    ⏱
                  </div>
                  <div class="space-y-1.5 text-xs sm:text-sm">
                    <h4 class="font-black text-amber-950 uppercase tracking-wider text-xs">
                      Clause 2.2 — Waiting Time & Demurrage Charges (£85/hr)
                    </h4>
                    <p>
                      Each quotation includes an allowance of up to <strong>two (2) hours on-site at collection</strong> and up to <strong>two (2) hours on-site at delivery</strong> for standard loading, securing, and unloading procedures.
                    </p>
                    <p class="font-semibold text-amber-950">
                      Any delays exceeding this allowance resulting from unready units, parked car obstructions, locked security gates, missing park keys, or delayed customer attendance will be charged at <strong>£85.00 + VAT per hour (or part thereof)</strong> per transport vehicle, plus any applicable escort vehicle standing charges.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- 3.0 Cancellation by the Company -->
            <div class="border-t border-slate-100 pt-6">
              <h3 class="text-lg font-black text-slate-900 mb-2">3.0 Cancellation by the Company</h3>
              <p>
                <strong>3.1 Safety & Regulatory Rescheduling:</strong> The Company reserves the absolute right to cancel, defer, or reschedule transport operations without financial penalty in the event of severe adverse weather warnings (including gale force winds exceeding safe transport thresholds for high-sided loads), national motorway closures, emergency police movement bans, mechanical breakdown, or unnotified roadworks. In such circumstances, the Company will re-schedule the movement at the earliest safe opportunity.
              </p>
            </div>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- SECTION 2: Readiness & Delivery (4.0 – 6.0) -->
        <!-- ========================================== -->
        <section id="collection-delivery" class="scroll-mt-32 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 lg:p-10 shadow-xs">
          <div class="border-b border-slate-200 pb-4 mb-6">
            <span class="text-xs font-black uppercase tracking-wider text-red-700">Section 2</span>
            <h2 class="text-2xl font-black text-slate-900 mt-1">Delivery Conditions, Access & Ground Protection</h2>
          </div>

          <div class="space-y-8 text-sm sm:text-base text-slate-700 leading-relaxed">
            <!-- 4.0 Delivery Conditions -->
            <div>
              <h3 class="text-lg font-black text-slate-900 mb-2">4.0 Delivery Conditions</h3>
              <p class="mb-3">
                <strong>4.1 Route Verification:</strong> The Customer is solely responsible for verifying and ensuring suitable access routes, gate widths, turning geometry, and overhead clearances from the public highway to the delivery drop-off point.
              </p>

              <!-- CALLOUT: Clause 4.2 -->
              <div class="my-5 rounded-2xl border-2 border-amber-500/80 bg-amber-50/70 p-4 sm:p-5 text-slate-900">
                <div class="flex items-start gap-3">
                  <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-600 text-white font-black text-xs mt-0.5">
                    ⚠
                  </div>
                  <div class="space-y-2 text-xs sm:text-sm">
                    <h4 class="font-black text-amber-950 uppercase tracking-wider text-xs">
                      Clause 4.2 – Mandatory Access Width and Height Clearance
                    </h4>
                    <p>
                      The Customer shall be solely responsible for ensuring that all access routes, roads, gateways, entrances, driveways and delivery areas are suitable and sufficiently wide and high to accommodate the transport vehicle, associated equipment and the mobile home, caravan, lodge or other unit being transported.
                    </p>
                    <p>
                      A minimum unobstructed width equal to the overall width of the transported unit plus two (2) feet (0.6 metres) must be maintained throughout the entire access route. A minimum unobstructed vertical clearance of fifteen (15) feet (4.57 metres) must also be provided, unless a greater clearance is specified by the Company.
                    </p>
                    <p>
                      These minimum requirements do not constitute confirmation that any particular route is suitable. Additional clearance may be necessary to accommodate vehicle dimensions, turning circles, overhangs, gradients and manoeuvring requirements.
                    </p>
                    <p>
                      The Customer shall ensure that all routes are free from obstructions, including but not limited to walls, fences, gateposts, trees, branches, overhead cables, buildings, parked vehicles, rockeries and other structures.
                    </p>
                  </div>
                </div>
              </div>

              <p class="my-3">
                <strong>4.3 Drop-off Location:</strong> If the intended plot or pitch cannot be safely reached due to width or ground restrictions, delivery will be completed at the nearest safe hard-standing area, which shall constitute full and final completion of carriage under the contract.
              </p>

              <!-- CALLOUT: Clause 4.4 -->
              <div class="my-5 rounded-2xl border-2 border-red-500/80 bg-red-50/70 p-4 sm:p-5 text-slate-900">
                <div class="flex items-start gap-3">
                  <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-600 text-white font-black text-xs mt-0.5">
                    ⚠
                  </div>
                  <div class="space-y-2 text-xs sm:text-sm">
                    <h4 class="font-black text-red-950 uppercase tracking-wider text-xs">
                      Clause 4.4 – Strict Hard-Standing and Ground Suitability Requirements
                    </h4>
                    <p>
                      The Customer shall be responsible for ensuring that all access routes, manoeuvring areas and delivery locations have sufficient ground stability, load-bearing capacity and suitable hard-standing to support the Company's vehicles, trailers, plant and equipment, which may operate at gross train weights of up to 44 tonnes.
                    </p>
                    <p>
                      Under no circumstances shall the Company's vehicles be required to enter or operate upon soft grass, uncompacted soil, mud, unmade ground or any other potentially unsuitable surface without prior assessment and the Company's written agreement.
                    </p>
                    <p>
                      The Company's drivers and representatives shall retain absolute discretion to refuse, suspend or terminate access, manoeuvring or delivery where, in their reasonable judgement, conditions present a risk to persons, vehicles, equipment, property or the transported unit.
                    </p>
                    <p>
                      Any additional costs reasonably incurred as a result of unsuitable ground conditions, inadequate access or failed delivery arrangements shall be payable by the Customer.
                    </p>
                  </div>
                </div>
              </div>

              <!-- CALLOUT: Clause 4.5 -->
              <div class="my-5 rounded-2xl border-2 border-red-500/80 bg-red-50/70 p-4 sm:p-5 text-slate-900">
                <div class="flex items-start gap-3">
                  <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-600 text-white font-black text-xs mt-0.5">
                    🛡
                  </div>
                  <div class="space-y-3 text-xs sm:text-sm">
                    <h4 class="font-black text-red-950 uppercase tracking-wider text-xs">
                      Clause 4.5 – Customer Responsibility for Access Restrictions, Property Damage and Indemnity
                    </h4>
                    <ul class="space-y-3 pl-0 list-none">
                      <li class="border-t border-red-200/60 pt-2.5 first:border-t-0 first:pt-0">
                        <strong>4.5.1 – Customer's Responsibility:</strong> The Customer acknowledges and agrees that responsibility for assessing, verifying and providing suitable access to the collection and delivery locations rests with the Customer, except to the extent that the Company has expressly agreed in writing to undertake a specific access assessment. The Customer warrants that all access routes, gateways, entrances, turning areas and delivery locations comply with the clearance, width, height, ground stability and other access requirements specified by the Company.
                      </li>
                      <li class="border-t border-red-200/60 pt-2.5">
                        <strong>4.5.2 – Damage Arising from Inadequate Access:</strong> To the fullest extent permitted by law, the Company shall not be liable for any loss or damage to property arising directly from inadequate, restricted, obstructed or unsuitable access conditions where such loss or damage results from the Customer's failure to comply with the requirements of these Terms and Conditions. This includes, without limitation, damage to walls, fences, gates, gateposts, pillars, driveways, paving, kerbs, landscaping, trees, buildings, underground services, the transported unit or any other property. Where damage arises from insufficient clearance, restricted access width, inadequate turning space, unsuitable ground conditions or other access deficiencies for which the Customer is responsible, the Customer shall bear responsibility for the resulting loss or damage, except to the extent caused by the Company's negligence, breach of contract or other legal responsibility which cannot lawfully be excluded.
                      </li>
                      <li class="border-t border-red-200/60 pt-2.5">
                        <strong>4.5.3 – Customer Indemnity:</strong> The Customer shall indemnify and keep indemnified We Move Mobile Homes Ltd against all reasonable and properly incurred losses, liabilities, damages, costs, expenses and third-party claims arising directly from the Customer's failure to provide access meeting the requirements of these Terms and Conditions. This indemnity shall apply only to the extent that such losses or claims are attributable to the Customer's breach of their access obligations and shall not extend to losses caused by the Company's negligence, breach of contract or other legally non-excludable liability.
                      </li>
                      <li class="border-t border-red-200/60 pt-2.5">
                        <strong>4.5.4 – Authority to Refuse Access:</strong> The Company and its drivers reserve the right, acting reasonably, to refuse, suspend or discontinue any collection, delivery or manoeuvring operation where access conditions are considered unsafe, inadequate or unsuitable. The Customer shall remain responsible for reasonable additional charges arising from such circumstances where the failure to provide suitable access is attributable to the Customer. Such charges may include aborted delivery, waiting time, additional transport, specialist equipment, storage and return journeys.
                      </li>
                      <li class="border-t border-red-200/60 pt-2.5">
                        <strong>4.5.5 – No Waiver of Customer Obligations:</strong> Any preliminary access assessment, inspection, advice, assistance or attempted delivery undertaken by the Company shall not relieve the Customer of their obligations under these clauses, unless the Company expressly agrees otherwise in writing. The Company's decision to attempt access shall not, of itself, constitute confirmation that the route is suitable or a waiver of the Customer's contractual responsibilities.
                      </li>
                      <li class="border-t border-red-200/60 pt-2.5">
                        <strong>4.5.6 – Statutory Rights:</strong> Nothing in these clauses shall exclude or restrict liability for death or personal injury caused by negligence, fraud or fraudulent misrepresentation, or any other liability which cannot lawfully be excluded or restricted. Where the Customer is a consumer, nothing in these clauses shall affect their statutory rights under the Consumer Rights Act 2015.
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <!-- 5.0 Delays -->
            <div class="border-t border-slate-100 pt-6">
              <h3 class="text-lg font-black text-slate-900 mb-2">5.0 Delays</h3>
              <p>
                <strong>5.1 Consequential Loss Exclusion:</strong> Transit delivery times and dates are estimated in good faith. The Company shall not be liable for any indirect or consequential loss, cost, or expense incurred by the Customer (including park accommodation fees, lost wages, temporary living costs, or crane hire cancellation fees) resulting from motorway traffic delays, police regulatory holds, or mechanical repairs.
              </p>
            </div>

            <!-- 6.0 Ground Protection -->
            <div class="border-t border-slate-100 pt-6">
              <h3 class="text-lg font-black text-slate-900 mb-2">6.0 Ground Protection</h3>
              <p>
                <strong>6.1 Trackway & Private Paving:</strong> Where access across lawns, soft park ground, or fragile block paving is requested, the Customer must supply and lay heavy-duty ground protection mats or trackway boards prior to vehicle arrival. The Company accepts zero liability for turf disturbance, ground rutting, cracked pavers, or damage to concealed underground utilities (such as water pipes, septic tanks, or soakaways) when operating on private ground under the Customer's direction.
              </p>
            </div>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- SECTION 3: Transit & Insurance (7.0 – 10.0) -->
        <!-- ========================================== -->
        <section id="transit-insurance" class="scroll-mt-32 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 lg:p-10 shadow-xs">
          <div class="border-b border-slate-200 pb-4 mb-6">
            <span class="text-xs font-black uppercase tracking-wider text-red-700">Section 3</span>
            <h2 class="text-2xl font-black text-slate-900 mt-1">Transit Liability, Subcontracting & Contents</h2>
          </div>

          <div class="space-y-8 text-sm sm:text-base text-slate-700 leading-relaxed">
            <!-- 7.0 Subcontracting -->
            <div>
              <h3 class="text-lg font-black text-slate-900 mb-2">7.0 Subcontracting</h3>
              <p>
                <strong>7.1 Right to Delegate:</strong> The Company reserves the right to engage accredited, vetted subcontractors, partner low loader operators, or specialist escort contractors to execute carriage or ancillary operations in whole or in part, subject to these same contractual terms and RHA standards.
              </p>
            </div>

            <!-- 8.0 Transit Liability -->
            <div class="border-t border-slate-100 pt-6">
              <h3 class="text-lg font-black text-slate-900 mb-2">8.0 Transit Liability</h3>
              <p>
                <strong>8.1 Scope of Transit:</strong> Carriage of goods is undertaken subject to the Road Haulage Association (RHA) Conditions of Carriage 2010 and these special conditions. Transit commences when the unit is winched or loaded onto the transport vehicle and secured, and terminates upon vehicle arrival at the destination drop-off location prior to offloading.
              </p>
            </div>

            <!-- 9.0 Customer Responsibilities -->
            <div class="border-t border-slate-100 pt-6">
              <h3 class="text-lg font-black text-slate-900 mb-2">9.0 Customer Responsibilities</h3>
              <p class="mb-2">
                <strong>9.1 Weatherproofing & External Fixtures:</strong> Prior to transport vehicle arrival, the Customer must ensure that all external windows, skylights, vents, pop-outs, and doors are securely latched, locked, and weatherproofed.
              </p>
              <p>
                <strong>9.2 Ancillary Dismantling:</strong> All exterior decking, skirting, awnings, satellite dishes, aerials, flue terminals, and gas bottles must be completely dismantled and removed from the exterior of the home prior to collection. The Company accepts no liability for unfastened items detaching during transit.
              </p>
            </div>

            <!-- 10.0 Insurance & Internal Contents -->
            <div class="border-t border-slate-100 pt-6">
              <h3 class="text-lg font-black text-slate-900 mb-2">10.0 Insurance & Internal Contents</h3>
              <p class="mb-3">
                <strong>10.1 Structural Transit Insurance:</strong> Fully comprehensive Goods-in-Transit insurance covers the physical shell, chassis, and factory-fitted structure of the mobile home while on board the carrier's vehicle, subject to policy limits and excess terms.
              </p>

              <!-- CALLOUT: Clause 10.2 -->
              <div class="my-4 rounded-2xl border-2 border-red-500/80 bg-red-50/70 p-4 sm:p-5 text-slate-900">
                <div class="flex items-start gap-3">
                  <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-600 text-white font-black text-xs mt-0.5">
                    ⚖
                  </div>
                  <div class="space-y-2 text-xs sm:text-sm">
                    <h4 class="font-black text-red-950 uppercase tracking-wider text-xs">
                      Clause 10.2 — Unit Weight Compliance & Customer Clearance of Contents
                    </h4>
                    <p>
                      Mobile homes and park lodges are surveyed and transported based on standard manufacturer tare specifications.
                    </p>
                    <p class="font-bold text-red-950">
                      The Customer MUST completely empty the unit of all personal belongings, loose furniture, white goods, heavy personal effects, building supplies, tools, and stored excess weight prior to collection.
                    </p>
                    <p>
                      Transporting overloaded units introduces dangerous structural hazards, including catastrophic chassis buckling, tire blowouts, axle failure, and commercial axle-overload violations under UK highway legislation. The Company accepts <strong>zero liability for internal breakage, furniture damage, or chassis distortion</strong> caused by unemptied contents, and the Customer shall indemnify the Company against any DVSA/police overload fines incurred.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- SECTION 4: Permits & Safety (11.0 – 14.0) -->
        <!-- ========================================== -->
        <section id="permits-safety" class="scroll-mt-32 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 lg:p-10 shadow-xs">
          <div class="border-b border-slate-200 pb-4 mb-6">
            <span class="text-xs font-black uppercase tracking-wider text-red-700">Section 4</span>
            <h2 class="text-2xl font-black text-slate-900 mt-1">Permits, Escort Vehicles & Driver Authority</h2>
          </div>

          <div class="space-y-8 text-sm sm:text-base text-slate-700 leading-relaxed">
            <!-- 11.0 Permits -->
            <div>
              <h3 class="text-lg font-black text-slate-900 mb-2">11.0 Permits & Police Notifications</h3>
              <p class="mb-2">
