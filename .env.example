# Site Configuration
# Canonical domain for sitemap and metadata resolution
SITE_URL=https://wemovemobilehomes.co.uk

# Google Search Console (GSC) Verification
# Value from Google Search Console HTML tag method: <meta name="google-site-verification" content="TOKEN" />
PUBLIC_GOOGLE_SITE_VERIFICATION=your_gsc_token_here

# Google Analytics 4 (GA4) / Google Tag Manager
# Measurement ID formatted as G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
